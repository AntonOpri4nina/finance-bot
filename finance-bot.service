[Unit]
Description=Finance Bot Telegram Service
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=finance-bot
WorkingDirectory=/home/finance-bot/finance-bot
EnvironmentFile=/home/finance-bot/finance-bot/.env
ExecStart=/usr/bin/python3 /home/finance-bot/finance-bot/bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=finance-bot

# Автозапуск сервиса при перезагрузке
[Install]
WantedBy=multi-user.target
